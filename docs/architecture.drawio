<mxfile host="app.diagrams.net">
  <diagram id="document-chat" name="Architecture">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="docker" parent="1" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry x="170" y="100" width="1520" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="dockerLabel" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666" value="Docker Compose · frontend :8501 · backend :8000" vertex="1">
          <mxGeometry x="185" y="108" width="360" height="20" as="geometry" />
        </mxCell>
        <mxCell id="backend" parent="1" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fffcf0;strokeColor=#d6b656;fontSize=16;fontStyle=1;verticalAlign=top;spacingTop=6" value="Backend (FastAPI)" vertex="1">
          <mxGeometry x="450" y="140" width="1210" height="1030" as="geometry" />
        </mxCell>
        <mxCell id="ports" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;fontSize=12;fontStyle=2;fontColor=#4a6a9c;align=right;verticalAlign=bottom;spacingRight=10;spacingBottom=4" value="Model clients (swappable behind small interfaces)" vertex="1">
          <mxGeometry x="480" y="880" width="1140" height="160" as="geometry" />
        </mxCell>

        <mxCell id="user" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1" value="User" vertex="1">
          <mxGeometry x="60" y="510" width="40" height="90" as="geometry" />
        </mxCell>
        <mxCell id="frontend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14" value="&lt;b&gt;Streamlit frontend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Upload PDF / TXT&lt;br&gt;Chat history&lt;br&gt;Highlighted sources&lt;br&gt;Answer artifacts + model comparison&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#555555&quot;&gt;session_id per browser tab&lt;/font&gt;" vertex="1">
          <mxGeometry x="200" y="470" width="190" height="170" as="geometry" />
        </mxCell>
        <mxCell id="eval" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f1f8e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=13" value="&lt;b&gt;Evaluation&lt;/b&gt; (backend/scripts)&lt;br&gt;Handbook + 500-page catalogue&lt;br&gt;R@4 1.00 · MRR 0.92&lt;br&gt;Refusals 15/15 · param sweeps" vertex="1">
          <mxGeometry x="195" y="760" width="235" height="120" as="geometry" />
        </mxCell>

        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" value="&lt;b&gt;API layer&lt;/b&gt;&amp;nbsp; POST /documents/process · POST /chat · GET /health&lt;br&gt;Pydantic schemas · HTTP 503 when Ollama is unavailable" vertex="1">
          <mxGeometry x="640" y="210" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="laneIndex" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666" value="Indexing path" vertex="1">
          <mxGeometry x="500" y="310" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="laneQuery" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666" value="Query path" vertex="1">
          <mxGeometry x="1150" y="310" width="100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ingest" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" value="&lt;b&gt;Ingestion&lt;/b&gt;&lt;br&gt;PDF (pypdf, per page) · TXT · MD&lt;br&gt;dedupe by content hash" vertex="1">
          <mxGeometry x="480" y="360" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="chunk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" value="&lt;b&gt;Chunking&lt;/b&gt;&lt;br&gt;Page-aware · 180 words · 40 overlap" vertex="1">
          <mxGeometry x="480" y="500" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="indexer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" value="&lt;b&gt;Indexer&lt;/b&gt;&lt;br&gt;Embed only new chunks · store per session" vertex="1">
          <mxGeometry x="480" y="640" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="store" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" value="&lt;b&gt;In-memory index&lt;/b&gt;&lt;br&gt;session_id → chunks + vectors&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#555555&quot;&gt;replaced per upload · lost on restart&lt;/font&gt;" vertex="1">
          <mxGeometry x="820" y="730" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="orch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13" value="&lt;b&gt;RAG orchestrator&lt;/b&gt; (chat route)&lt;br&gt;rag.py · history-aware query&lt;br&gt;JSON reply · refusal flag hides sources" vertex="1">
          <mxGeometry x="960" y="360" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="retrieve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#2e7d32;strokeWidth=3;fontSize=13" value="&lt;b&gt;Hybrid retrieval&lt;/b&gt;&lt;br&gt;Dense cosine (≥ 0.5, top 20)&lt;br&gt;+ BM25 keyword (top 20)&lt;br&gt;RRF fusion (k = 60)" vertex="1">
          <mxGeometry x="880" y="510" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rerank" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#2e7d32;strokeWidth=3;fontSize=13" value="&lt;b&gt;Reranker&lt;/b&gt; (optional)&lt;br&gt;Cross-encoder ms-marco-MiniLM-L-6&lt;br&gt;scores (question, chunk) pairs&lt;br&gt;drops clear noise" vertex="1">
          <mxGeometry x="1270" y="510" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="embed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" value="&lt;b&gt;Embedder&lt;/b&gt; (OllamaClient)&lt;br&gt;embed_documents · embed_query" vertex="1">
