        <mxCell id="ollama" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14" value="&lt;b&gt;Ollama&lt;/b&gt; (container by default, host optional · no API key)&lt;br&gt;nomic-embed-text · /api/embed&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;llama3.2:3b · /api/generate" vertex="1">
