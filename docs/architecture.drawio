        <mxCell id="llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" value="&lt;b&gt;LLM&lt;/b&gt; (OllamaClient)&lt;br&gt;generate · temperature 0" vertex="1">
